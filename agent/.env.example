## Runtime configuration for the IROS backend.
## Copy to .env and fill in real values. Never commit the real .env file.

APP_ENV=local
LOG_LEVEL=INFO

# SQLite (system of record + LangGraph checkpoints) — zero-server backend, a
# single local file, no Postgres/Docker install needed at all. Swap to a
# postgresql+asyncpg://user:pass@host:5432/db URL instead for a real shared/
# production deployment (see docker-compose.yml at the repo root for one way to
# stand up that Postgres) — src/db/session.py and
# src/agents/checkpointing/checkpointer.py both branch on this URL's scheme.
DATABASE_URL=sqlite+aiosqlite:///./iros.db
LANGGRAPH_CHECKPOINT_SCHEMA=langgraph_checkpoints

# Object storage (MinIO locally, S3 in production)
OBJECT_STORE_ENDPOINT=http://localhost:9000
OBJECT_STORE_BUCKET=iros-artifacts
OBJECT_STORE_ACCESS_KEY=changeme
OBJECT_STORE_SECRET_KEY=changeme

# Search
OPENSEARCH_URL=http://localhost:9200
PGVECTOR_ENABLED=true

# Cache / locks
REDIS_URL=redis://localhost:6379/0

# Model routing (see docs/adr/0004-model-routing-policy.md)
LOCAL_MODEL_ENDPOINT=http://localhost:11434
LOCAL_MODEL_NAME=llama3.1
CLOUD_MODEL_PROVIDER=
CLOUD_MODEL_NAME=
CLOUD_MODEL_API_KEY=

# Auth
JWT_SECRET=changeme
JWT_ISSUER=iros

# Data acquisition
SEC_EDGAR_USER_AGENT="IROS research-agent contact@example.com"
NEWS_API_KEY=
NEWS_API_BASE_URL=https://newsapi.org/v2
# Real SEC EDGAR + news connectors (src/services/connectors/) are off by default
# so local dev/CI stays network-free against the ACME fixture. Set true once
# Postgres etc. are up and you want acquisition_orchestrator to hit real sources.
USE_REAL_DATA_SOURCES=false
